# Earthward Foundry — environment variables
# Copy this file to .env and fill in your values.
# .env is in .gitignore and will never be committed.

# Required for live_agent.py and live_demo.py
ANTHROPIC_API_KEY=sk-ant-...

# Optional — only needed if adding OpenAI model support
# OPENAI_API_KEY=sk-...

# --- Rescue API (services/rescue) ---------------------------------------

# Required in production. The API refuses all non-exempt requests with
# 500 ServerMisconfigured until this is set (or ALLOW_UNAUTHENTICATED=true
# is set for local demos only). Generate with e.g. `openssl rand -hex 32`.
RESCUE_API_KEY=

# Bind host/port for the rescue Flask API.
# RESCUE_API_HOST=127.0.0.1
# RESCUE_API_PORT=5001

# Enable Flask debug mode — never in production. Refused outright if
# RESCUE_API_HOST is not 127.0.0.1/localhost.
# RESCUE_API_DEBUG=false

# Optional — override the default SQLite path (e.g. for a mounted volume
# in a container). Defaults to services/rescue/earthward_rescue.db.
# RESCUE_DB_PATH=/app/data/earthward_rescue.db

# --- Traceability API (services/traceability) ---------------------------

# Required in production, same semantics as RESCUE_API_KEY above.
TRACEABILITY_API_KEY=

# Bind host/port for the traceability Flask API.
# TRACEABILITY_API_HOST=127.0.0.1
# TRACEABILITY_API_PORT=5000

# Enable Flask debug mode — never in production. Refused outright if
# TRACEABILITY_API_HOST is not 127.0.0.1/localhost.
# TRACEABILITY_API_DEBUG=false

# Optional — override the default SQLite path (e.g. for a mounted volume
# in a container). Defaults to services/traceability/earthward_traceability.db.
# TRACEABILITY_DB_PATH=/app/data/earthward_traceability.db

# --- Shared auth/rate-limit settings -------------------------------------

# Set to "true" to allow unauthenticated requests to either API. Intended
# ONLY for local demos on 127.0.0.1 — never set this on a deployed instance.
# ALLOW_UNAUTHENTICATED=false

# Requests allowed per client per minute before a 429, per process.
# Set to 0 to disable rate limiting entirely. Applies to both APIs.
# RATE_LIMIT_PER_MINUTE=120

# Log verbosity for the structured request/response logger (both APIs).
# One of DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=INFO
